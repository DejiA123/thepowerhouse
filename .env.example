# Required Environment Variables for Lovable Deployment

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ElevenLabs API Configuration (for Max McLean TTS Service)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Note: These environment variables must be configured in your Lovable project settings
# Go to your Lovable project dashboard and add these variables in the Environment Variables section