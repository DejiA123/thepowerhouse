  "mailer_templates_magic_link_content": "<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;padding:24px;color:#0f172a\"><h2 style=\"margin:0 0 12px\">Your sign-in code</h2><p style=\"margin:0 0 16px\">Type this code in the app to sign in:</p><p style=\"font-size:32px;font-weight:700;letter-spacing:8px;margin:0 0 20px\">{{ .Token }}</p><p style=\"margin:0 0 20px\">Or open this email on the same phone and <a href=\"{{ .ConfirmationURL }}\">tap here to sign in</a>.</p><p style=\"margin:0;color:#64748b;font-size:13px\">The code works once. If you didn't ask for it, you can ignore this email.</p></div>",
  "mailer_subjects_confirmation": "Confirm your email",
  "mailer_templates_confirmation_content": "<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;padding:24px;color:#0f172a\"><h2 style=\"margin:0 0 12px\">Confirm your email</h2><p style=\"margin:0\">Tap the button to finish creating your account.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-weight:600;padding:13px 22px;border-radius:12px\">Confirm my email</a></p><p style=\"margin:0;color:#64748b;font-size:13px\">Then sign in with your email and the password you chose.</p><p style=\"margin:20px 0 0;color:#64748b;font-size:13px\">If you didn't ask for this, you can ignore this email.</p></div>",
  "mailer_subjects_recovery": "Reset your password",
  "mailer_templates_recovery_content": "<div style=\"font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;max-width:480px;margin:0 auto;padding:24px;color:#0f172a\"><h2 style=\"margin:0 0 12px\">Reset your password</h2><p style=\"margin:0\">Tap the button to choose a new password.</p><p style=\"margin:22px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-weight:600;padding:13px 22px;border-radius:12px\">Choose a new password</a></p><p style=\"margin:20px 0 0;color:#64748b;font-size:13px\">If you didn't ask for this, you can ignore this email.</p></div>"
